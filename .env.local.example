# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Session Secret (Optional / for session signing if needed)
SESSION_SECRET=your-session-secret

# Resend Email Configuration (Server-Side Only - never expose to client)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Cheaper Support <support@cheaper.com>
SUPPORT_EMAIL=support@cheaper.com
